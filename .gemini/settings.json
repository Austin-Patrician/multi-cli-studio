{
  "hooks": {
    "BeforeAgent": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${GEMINI_PROJECT_DIR}/.gemini/hooks/inject-workflow-state.py\"",
            "name": "studio-before-agent",
            "timeout": 5000,
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${GEMINI_PROJECT_DIR}/.gemini/hooks/session-start.py\"",
            "name": "studio-session-start",
            "timeout": 10000,
            "type": "command"
          }
        ]
      }
    ]
  }
}
