{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/session-start.py\"",
            "statusMessage": "Loading Studio Context Native Hook...",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "startup|resume|clear"
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"$(git rev-parse --show-toplevel)/.codex/hooks/inject-workflow-state.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
