{
  "enabledPlugins": {},
  "env": {
    "CLAUDE_BASH_MAINTAIN_PROJECT_WORKING_DIR": "1"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "startup"
      },
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "resume"
      },
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "clear"
      },
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/session-start.py\"",
            "timeout": 10,
            "type": "command"
          }
        ],
        "matcher": "compact"
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-subagent-context.py\"",
            "timeout": 30,
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "/usr/bin/python3 \"${CLAUDE_PROJECT_DIR}/.claude/hooks/inject-workflow-state.py\"",
            "timeout": 5,
            "type": "command"
          }
        ]
      }
    ]
  }
}
